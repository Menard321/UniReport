generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String?
  passwordHash  String
  university    String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  subscription        Subscription?
  documents           Document[]
  activityLogs        ActivityLog[]
  reportPlans         ReportPlan[]
  paymentTransactions PaymentTransaction[]
  supportTickets      SupportTicket[]
  notifications       Notification[]
  reportSpecifications ReportSpecificationRecord[]
}

enum UserRole {
  STUDENT
  ACADEMIC_STAFF
  UNIREPORT_ADMIN
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  tier          TierLevel @default(FREE)
  isActive      Boolean   @default(true)
  
  // Usage tracking against limits
  projectsUsed  Int       @default(0)
  aiTokensUsed  Int       @default(0)
  storageUsedMb Float     @default(0.0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TierLevel {
  FREE
  STUDENT
  PRO
  INSTITUTIONAL
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  title         String
  content       String    @db.Text
  toolType      String    // e.g. "lit-review", "methodology", "field-report"
  
  storageSizeKb Float     @default(0.0)
  isPaid        Boolean   @default(false)
  targetPages   Int       @default(10)
  downloadUrl   String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String    // e.g. "AI_GENERATION", "PLAN_UPGRADE"
  tokensCost    Int?
  metadata      String?   @db.Text
  
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DEEP ACADEMIC REPORT ORCHESTRATION MODELS
model ReportPlan {
  id            String          @id @default(cuid())
  userId        String
  title         String
  reportType    String          // e.g. "FYP", "FIELDWORK", "DISSERTATION"
  institution   String
  targetPages   Int             @default(10)
  totalWordTarget Int           @default(3500)
  citationStyle String          @default("APA7")
  customTemplate String?        @db.Text
  status        String          @default("PLANNING") // PLANNING, GENERATING, VERIFYING, COMPLETED
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections      ReportSection[]
  citations     Citation[]
}

model ReportSection {
  id            String     @id @default(cuid())
  planId        String
  chapterNumber Int
  title         String
  subHeadings   String[]
  wordBudget    Int
  content       String?    @db.Text
  status        String     @default("PENDING") // PENDING, GENERATING, COMPLETED, DEFICIENT
  qaScore       Int?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  plan          ReportPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Citation {
  id                 String     @id @default(cuid())
  planId             String
  authors            String
  title              String
  year               Int
  journal            String?
  doi                String?
  url                String?
  verificationStatus String     @default("UNVERIFIED") // VERIFIED, UNVERIFIED, MISMATCH
  
  createdAt          DateTime   @default(now())

  plan               ReportPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// LIVE PRODUCTION COMMERCE & MONITORING MODELS
// -----------------------------------------------------------------------------

model PaymentTransaction {
  id          String          @id @default(cuid())
  userId      String
  reference   String          @unique
  amount      Int             // in TZS
  currency    String          @default("TZS")
  provider    PaymentProvider
  tier        TierLevel
  status      PaymentStatus   @default(PENDING)
  phone       String?
  metadata    String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentProvider {
  M_PESA
  TIGO_PESA
  AIRTEL_MONEY
  HALOPESA
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model SupportTicket {
  id          String          @id @default(cuid())
  userId      String
  institution String?
  subject     String
  category    String          // e.g. "BILLING", "AI_GENERATION", "CITATION", "SYSTEM_ACCESS"
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  sender      MessageSender
  text        String        @db.Text
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

enum MessageSender {
  STUDENT
  SUPPORT_AGENT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model University {
  id              String           @id @default(cuid())
  name            String           @unique
  shortName       String           @unique
  domain          String?
  location        String
  campuses        Int              @default(1)
  programmesCount Int              @default(10)
  status          UniversityStatus @default(VERIFIED)
  reportTypes     String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum UniversityStatus {
  VERIFIED
  PENDING_REVIEW
}

// -----------------------------------------------------------------------------
// ALL-DISCIPLINE REPORT ENGINE ARCHITECTURAL MODELS
// -----------------------------------------------------------------------------

enum DisciplineStatus {
  VERIFIED_PRODUCTION
  BETA
  EXPERIMENTAL
  AWAITING_VERIFICATION
}

model DisciplineRegistryRecord {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  category            String           // STEM, HEALTH, HUMANITIES, COMMERCE, EDUCATION
  status              DisciplineStatus @default(VERIFIED_PRODUCTION)
  statusNotes         String?
  supportedReportTypes String[]
  provenanceStandard  String?
  verifiedBy          String?
  lastAuditDate       DateTime?
  configJson          String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model ReportSpecificationRecord {
  id                     String    @id @default(cuid())
  userId                 String
  specificationId        String    @unique
  universityId           String
  universityName         String
  programmeId            String
  programmeName          String
  reportType             String
  reportTitle            String
  citationStyle          String
  totalTargetWords       Int
  formattingJson         String    @db.Text
  sectionsJson           String    @db.Text
  conflictsJson          String?   @db.Text
  status                 String    @default("COMPILED") // COMPILED, CONFIRMED, GENERATED, AUDITED
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculations           CalculationRecord[]
  diagrams               DiagramRecord[]
  complianceAudits       ComplianceAuditResult[]
}

model CalculationRecord {
  id                     String                    @id @default(cuid())
  specificationId        String
  calculationId          String                    @unique
  module                 String
  formulaCode            String
  formulaName            String
  latexEquation          String
  inputsJson             String                    @db.Text
  assumptionsJson        String?                   @db.Text
  intermediateStepsJson  String?                   @db.Text
  outputValue            Float
  outputFormatted        String
  outputUnit             String
  validationStatus       String                    @default("VALID")
  professionalDisclaimer String?                   @db.Text
  createdAt              DateTime                  @default(now())

  specification          ReportSpecificationRecord @relation(fields: [specificationId], references: [specificationId], onDelete: Cascade)
}

model DiagramRecord {
  id                     String                    @id @default(cuid())
  specificationId        String
  diagramId              String                    @unique
  diagramType            String
  title                  String
  caption                String?
  format                 String                    @default("MERMAID") // MERMAID, SVG_CHART, MATRIX_TABLE
  sourceDefinition       String                    @db.Text
  renderedSvg            String?                   @db.Text
  isValid                Boolean                   @default(true)
  createdAt              DateTime                  @default(now())

  specification          ReportSpecificationRecord @relation(fields: [specificationId], references: [specificationId], onDelete: Cascade)
}

model ComplianceAuditResult {
  id                     String                    @id @default(cuid())
  specificationId        String
  auditScore             Int                       // 0 - 100
  isCompliant            Boolean                   @default(true)
  structuralCheck        Boolean                   @default(true)
  numericalCheck         Boolean                   @default(true)
  visualCheck            Boolean                   @default(true)
  citationCheck          Boolean                   @default(true)
  privacyCheck           Boolean                   @default(true)
  disciplineCheck        Boolean                   @default(true)
  renderCheck            Boolean                   @default(true)
  errorsJson             String?                   @db.Text
  warningsJson           String?                   @db.Text
  remediationPlan        String?                   @db.Text
  auditedAt              DateTime                  @default(now())

  specification          ReportSpecificationRecord @relation(fields: [specificationId], references: [specificationId], onDelete: Cascade)
}

